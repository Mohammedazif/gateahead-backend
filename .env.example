# Leave empty for the website. Required only for the Telegram bot.
TELEGRAM_BOT_TOKEN=

# Site origins that call the API from a browser. Comma-separated.
WEB_ORIGIN=http://localhost:5173

# Optional Uvicorn proxy trust. Set only when the actual reverse proxy is known.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Folder for gateahead.db. Empty uses this backend project's data directory, independent of working directory.
# API, bot and worker must use the same persistent absolute path in production.
# Separate hosts need a shared database service; SQLite requires all processes on the same host/volume.
GATEAHEAD_DATA=

LOG_LEVEL=INFO
NEARBY_RADIUS_M=10000
RAIL_MAX_M=40
DUPLICATE_M=250
APPROACHING_ETA_MIN=30
CLOSING_SOON_ETA_MIN=10
# Minutes before the train that the barrier comes down. "Closes in" counts down to this.
GATE_LEAD_MIN=5
MAX_AHEAD_KM=80
DEFAULT_SPEED_KMH=60
ALERT_POLL_SECONDS=180
ALERT_COOLDOWN_MIN=15

# Live train checks per area request; all discovered candidates remain eligible.
LIVE_CHECK_BUDGET=30
# Maximum age for a timetable used in predictions. The catalog worker refreshes daily.
ROUTE_MAX_AGE_HOURS=168
# Look back this many hours for delayed journey instances at each crossing (6–168).
MAX_DELAY_HOURS=48

# Single-service runtime (Render or native host): API + worker, bot opt-in.
GATEAHEAD_ENABLE_BOT=false
# Render supplies PORT. Outside Render, the runtime defaults to port 8000.

# Optional saved-gate phone alerts. Use Application Default Credentials or set
# GOOGLE_APPLICATION_CREDENTIALS to a private service account file.
GATEAHEAD_FCM_PROJECT_ID=
# GATEAHEAD_PHONE_ALERT_POLL_SECONDS=120
# GATEAHEAD_PHONE_ALERT_AREAS_PER_POLL=6
# GATEAHEAD_PHONE_ALERT_SCAN_SECONDS=45
# GATEAHEAD_PHONE_ALERT_MAX_PHONES=60
# GATEAHEAD_PHONE_ALERT_MAX_SUBSCRIPTIONS=60
