# Leave empty for the website. Required only for the Telegram bot.
TELEGRAM_BOT_TOKEN=

# Site origins that call the API from a browser. Comma-separated.
WEB_ORIGIN=http://localhost:5173

# Folder for gateahead.db. Empty uses ./data.
# On Render, set this to the disk mount, for example /var/data.
GATEAHEAD_DATA=

LOG_LEVEL=INFO
NEARBY_RADIUS_M=10000
RAIL_MAX_M=40
DUPLICATE_M=250
APPROACHING_ETA_MIN=30
CLOSING_SOON_ETA_MIN=10
CLOSED_ETA_MIN=3
MAX_AHEAD_KM=80
DEFAULT_SPEED_KMH=60
ALERT_POLL_SECONDS=180
ALERT_COOLDOWN_MIN=15
